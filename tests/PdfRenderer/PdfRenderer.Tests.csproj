<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Include="../../FFTrueBard/Lessons/LessonPdfRenderer.cs" Link="LessonPdfRenderer.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabPdfDraft.cs" Link="TabPdfDraft.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabPdfRhythm.cs" Link="TabPdfRhythm.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabPdfScan.cs" Link="TabPdfScan.cs" />
    <Compile Include="../../FFTrueBard/Lessons/PianoMelodyTab.cs" Link="PianoMelodyTab.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabGuideBuilder.cs" Link="TabGuideBuilder.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabPdfGuide.cs" Link="TabPdfGuide.cs" />
    <Compile Include="../../FFTrueBard/Lessons/TabMidiGuide.cs" Link="TabMidiGuide.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonLibrary.cs" Link="LessonLibrary.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonCatalog.cs" Link="LessonCatalog.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonSequence.cs" Link="LessonSequence.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonScorePlayhead.cs" Link="LessonScorePlayhead.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonScoreCursor.cs" Link="LessonScoreCursor.cs" />
    <Compile Include="../../FFTrueBard/Lessons/LessonTablatureIndex.cs" Link="LessonTablatureIndex.cs" />
    <EmbeddedResource Include="../../FFTrueBard/Lessons/Indexes/guitar-aerobics.tablature.json"
                      LogicalName="FFTrueBard.Lessons.GuitarAerobics.tablature.json" />
    <EmbeddedResource Include="../../FFTrueBard/Lessons/Indexes/guitar-aerobics-*.playhead.json"
                      LogicalName="FFTrueBard.Lessons.Indexes.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
