<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.5.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Manifest fields (see DalamudPackager) -->
    <Author>claderino</Author>
    <Name>FFTrueBard</Name>
    <Punchline>Play Final Fantasy XIV with an electric guitar.</Punchline>
    <Description>Guitar practice tools and mapping editor, with audio health, guided manual tests, reviewed diagnostic exports, and settings recovery. Game input injection is not implemented.</Description>
    <RepoUrl>https://github.com/claderino/FFTrueBard</RepoUrl>
    <Tags>input;guitar;music;fun</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
