<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Manifest fields (see DalamudPackager) -->
    <Author>claderino</Author>
    <Name>FFTrueBard</Name>
    <Punchline>Play Final Fantasy XIV with an electric guitar.</Punchline>
    <Description>A guitar-to-input bridge. A small local app captures your guitar (NUX Mighty Space "Dry Out" USB routing), detects notes, and streams them to this plugin, which maps them to in-game keyboard/mouse input. Includes an in-game config UI and a live note log.</Description>
    <RepoUrl>https://github.com/claderino/FFTrueBard</RepoUrl>
    <Tags>input;guitar;music;fun</Tags>
  </PropertyGroup>

</Project>
