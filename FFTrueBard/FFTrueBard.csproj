<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.9.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Manifest fields (see DalamudPackager) -->
    <Author>claderino</Author>
    <Name>FFTrueBard</Name>
    <Punchline>Play Final Fantasy XIV with an electric guitar.</Punchline>
    <Description>Guitar practice with local PDF tablature, guided lesson cards, MP3 cues and loops, and optional pitch-order drills. Bring your own lesson files. Game input injection is not implemented.</Description>
    <RepoUrl>https://github.com/claderino/FFTrueBard</RepoUrl>
    <Tags>input;guitar;music;fun</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="160.0.8179" GeneratePathProperty="true" ExcludeAssets="all" />
    <None Include="$(Pkgbblanchon_PDFium_Win32)/runtimes/win-x64/native/pdfium.dll"
          Link="fftruebard-pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Lessons/Indexes/guitar-aerobics.tablature.json" LogicalName="FFTrueBard.Lessons.GuitarAerobics.tablature.json" />
  </ItemGroup>

</Project>
