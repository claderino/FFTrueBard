<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.1.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Manifest fields (see DalamudPackager) -->
    <Author>claderino</Author>
    <Name>FFTrueBard</Name>
    <Punchline>Play Final Fantasy XIV with an electric guitar.</Punchline>
    <Description>Guitar-to-input bridge with a built-in detector. Captures your guitar via WASAPI (NUX Mighty Space "Dry Out" USB routing), detects notes with YIN, and maps them to in-game keyboard/mouse input. Includes an in-game config UI with device picker and a live note log.</Description>
    <RepoUrl>https://github.com/claderino/FFTrueBard</RepoUrl>
    <Tags>input;guitar;music;fun</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
